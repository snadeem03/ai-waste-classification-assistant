# Virtual environments
.venv/
.venv-infer/
venv/
env/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets and local credentials (never commit)
secrets/
*.env
.env.*
!.env.example

# Datasets: large/raw/processed images and archives stay local.
# Small documentation and reproducibility metadata ARE tracked:
#   data/README.md, data/metadata/** (split manifests, class maps, counts, charts)
data/*
!data/README.md
!data/metadata/
!data/metadata/**
datasets/
data/raw/
data/processed/
data/inspection/
*.zip
*.tar
*.tar.gz
*.tgz
# Sample grids embed dataset photographs — never commit them
**/sample_grid*.png
**/sample_grid*.jpg
**/sample_grid*.jpeg

# Trained model binaries and checkpoints stay local.
# Small documentation and evaluation metadata ARE tracked:
#   models/README.md, models/metadata/**
*.keras
*.h5
*.hdf5
*.pb
*.tflite
*.onnx
saved_models/
checkpoints/
models/*
!models/README.md
!models/metadata/
!models/metadata/**
logs/

# Streamlit / Jupyter runtime
.streamlit/secrets.toml

# Demo photographs and screenshots stay local (personal photos are never
# committed); only the written observations live in docs/demo_results.md
demo/
